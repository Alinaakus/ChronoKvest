# ХроноКвест — статический сайт (HTML/CSS/JS, без бэкенда).
# Раздаём файлы из папки app/ через лёгкий веб-сервер nginx.
FROM nginx:alpine

# Копируем только содержимое app/ в корень веб-сервера.
# Папки plans/ и .business/ НЕ попадают сюда — они не раздаются наружу.
COPY app/ /usr/share/nginx/html/

# nginx слушает порт 80 (стандарт для HTTP) — это же ждёт Amvera.
EXPOSE 80
